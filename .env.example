# Copy to .env and change every value marked CHANGE-ME before a real demo.
POSTGRES_DB=zombieshield
POSTGRES_USER=zombieshield
POSTGRES_PASSWORD=CHANGE-ME-db-password
DATABASE_URL=postgresql+psycopg://zombieshield:CHANGE-ME-db-password@db:5432/zombieshield

JWT_SECRET=CHANGE-ME-to-a-random-string-of-at-least-32-characters
ADMIN_USERNAME=admin
ADMIN_PASSWORD=CHANGE-ME-admin-password
ANALYST_USERNAME=analyst
ANALYST_PASSWORD=CHANGE-ME-analyst-password
CLIENT_HASH_SALT=CHANGE-ME-random-salt

BACKEND_CORS_ORIGINS=http://localhost:5173
VITE_API_BASE_URL=http://localhost:8000

# online | offline | auto (try OSV.dev / KEV / EPSS, fall back to the cache)
THREAT_INTEL_MODE=auto
# Wall-clock budget (seconds) for online feed calls per run before falling back to the offline cache
# THREAT_INTEL_TIMEOUT_SECONDS=90

# Gateway rules (remediation stage). Rules are written to GATEWAY_RULES_DIR on "apply";
# only APIs on GATEWAY_HOSTS (comma-separated, empty = all) are rendered, proxied to GATEWAY_UPSTREAM.
# GATEWAY_UPSTREAM=http://sockshop_front_end
# GATEWAY_HOSTS=front-end
# GATEWAY_AUTH_VARIABLE=$zs_has_auth
# DEPRECATION_SUNSET_DAYS=90
